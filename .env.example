# Copy to .env and fill in real values. Never commit the real .env file.

# --- PostgreSQL (main application schema) ---
POSTGRES_DB=cohort
POSTGRES_USER=cohort_app
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- PostgreSQL (fl-service — isolated role, 3 bookkeeping tables only) ---
FL_POSTGRES_USER=cohort_fl
FL_POSTGRES_PASSWORD=change_me_too
FL_POSTGRES_SCHEMA=fl

# --- Spring Boot API ---
API_PORT=8080
JWT_SECRET=change_me_to_a_long_random_value
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=30

# --- fl-service (Python / Flower) ---
FL_SERVICE_PORT=8000
FL_MIN_COHORT_SIZE=3
FL_CLIPPING_NORM=1.0
FL_NOISE_MULTIPLIER=1.0

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8080/api/v1
FRONTEND_PORT=5173
